{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "12dPL honesty overrides",
  "type": "object",
  "properties": {
    "$comment": { "type": "string" },
    "functions": {
      "type": "object",
      "description": "Key: function name (applies to all overloads and to your own functions) or signature, e.g. \"Get_name(Element, Text &)\".",
      "additionalProperties": { "enum": ["honest", "dishonest"] }
    },
    "categories": {
      "type": "object",
      "description": "Re-classify every built-in in a category.",
      "propertyNames": {
        "enum": ["math", "text", "geometry", "container", "xml", "element", "project-handle", "ui-handle", "file-handle", "database-handle", "system-handle", "project", "screen", "prompt", "console", "file", "system", "time", "random", "other"]
      },
      "additionalProperties": { "enum": ["honest", "dishonest"] }
    },
    "ignoredGlobals": {
      "type": "array",
      "description": "Global variables that don't make a function dishonest when it reads or writes them.",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
